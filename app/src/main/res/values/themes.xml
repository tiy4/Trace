<?xml version="1.0" encoding="utf-8"?>
<!--
  主题：Material 3 + 跟随系统亮/暗。
  关键改动（相对旧版）：
    · DayNight → DayNight.NoActionBar：旧版带 ActionBar，而 vivo 在暗色系统下把 ActionBar 画成
      近黑色条，和浅色正文完全割裂；现在标题栏由布局自己画，四个页面的观感也统一了。
    · 颜色全部走语义角色（colorSurface / colorOnSurfaceVariant / …），不再散落颜色字面量，
      暗色只是 values-night/colors.xml 覆盖同名色。
    · 这里顺便定义了 Trace 的按钮/卡片/文字 style，布局只引用 style 名。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Trace" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 主色（品牌靛蓝） -->
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>

        <!-- 次色：给单选/复选/滑块用，跟随品牌色（琥珀只做「深夜冲动」语义色，见 colorTertiary） -->
        <item name="colorSecondary">@color/brand_500</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_container</item>
        <item name="colorTertiary">@color/amber_500</item>
        <item name="colorTertiaryContainer">@color/amber_container</item>
        <item name="colorOnTertiaryContainer">@color/on_amber_container</item>

        <!-- 容器与描边 -->
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_2</item>
        <item name="colorSurfaceContainer">@color/surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:statusBarColor" tools:targetApi="l">@android:color/transparent</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@android:color/transparent</item>

        <!-- 全部 Button 默认走品牌主按钮；需要浅底时显式 style="@style/Widget.Trace.Button.Tonal" -->
        <item name="materialButtonStyle">@style/Widget.Trace.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.Trace.Card</item>
    </style>

    <!-- ===== 按钮 ===== -->
    <!-- 主按钮：实心品牌色 + 白字。
         注意 MaterialButton 会忽略 android:background，只能靠 style/backgroundTint（旧的
         "@drawable/btn_primary + 紫字" 组合就是这样变成紫底紫字、按钮一片空白的）。 -->
    <style name="Widget.Trace.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- 次级按钮：淡紫底 + 紫字（替代原来的 @drawable/btn_secondary） -->
    <style name="Widget.Trace.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- ===== 卡片 ===== -->
    <style name="Widget.Trace.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <!-- ===== 文字 ===== -->
    <style name="Text.Trace.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Text.Trace.Metric" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Text.Trace.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- 遥测读数：等宽感的紧凑行距，用于 tvVlmStatus / tvMonitorStatus -->
    <style name="Text.Trace.Readout" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.Trace.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Text.Trace.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">10.5sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
