<?xml version="1.0" encoding="utf-8"?>
<!--
  主题：深色霓虹（Open Design 12 页设计规范 DESIGN SPEC 01/02/03）。
  关键点：
    · 应用是**纯深色**：parent 用 NoActionBar（标题栏由布局自己画），
      windowLightStatusBar=false，状态栏/导航栏直接用底色。
    · 颜色全部走语义角色（colorSurface / colorOnSurfaceVariant / …），
      布局不写颜色字面量；亮/暗由 values-night 与 values 保持一致来兜住。
    · 主按钮用 accent -> accent-2 的 135° 渐变（@drawable/bg_cta）；
      MaterialButton 会无视 android:background，必须同时把 backgroundTint 置 null。
    · 卡片统一玻璃材质：白 6% 填充 + 白 10% 描边 + 18dp 圆角。
-->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Trace" parent="Theme.Material3.Dark.NoActionBar">
        <!-- 主色（品牌蓝，取自渐变的蓝色端） -->
        <item name="colorPrimary">@color/brand_500</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>

        <!-- 次色：单选/复选/滑块/开关，跟随强调蓝 -->
        <item name="colorSecondary">@color/accent_2</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_container</item>
        <item name="colorTertiary">@color/amber_500</item>
        <item name="colorTertiaryContainer">@color/amber_container</item>
        <item name="colorOnTertiaryContainer">@color/on_amber_container</item>

        <!-- 容器与描边 -->
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_2</item>
        <item name="colorSurfaceContainer">@color/surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>

        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_2</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/bg</item>
        <item name="android:navigationBarColor" tools:targetApi="l">@color/bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="materialButtonStyle">@style/Widget.Trace.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.Trace.Card</item>
    </style>

    <!-- ===== 按钮 ===== -->
    <!-- 主按钮：强调色渐变 + 白字（不要给 MaterialButton 写 android:background 之外的
         颜色字面量——旧版就是那样变成紫底紫字、按钮一片空白的）。 -->
    <style name="Widget.Trace.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">46dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/bg_cta</item>
        <item name="backgroundTint">@null</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">@color/on_brand</item>
    </style>

    <!-- 次级按钮：玻璃底 + 浅字（卡内成对操作） -->
    <style name="Widget.Trace.Button.Tonal" parent="Widget.Material3.Button">
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/glass_strong</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- 强调次级按钮：蓝底浅字，用于「推荐/主推」的那一个次级操作 -->
    <style name="Widget.Trace.Button.Accent" parent="Widget.Material3.Button">
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="backgroundTint">@color/brand_container</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textColor">@color/on_brand_container</item>
    </style>

    <!-- ===== 卡片 ===== -->
    <style name="Widget.Trace.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/glass</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/glass_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">false</item>
    </style>

    <!-- 嵌在卡里的读数/列表底：比卡片再沉一层。
         parent="" 是必须的：style 名里的点会被 AAPT 当成隐式父样式
         （Widget.Trace.Inset → 去找不存在的 Widget.Trace，直接编译失败）。 -->
    <style name="Widget.Trace.Inset" parent="">
        <item name="android:background">@drawable/bg_inset</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- ===== 文字（DESIGN SPEC 02 字号规范） ===== -->
    <!-- 页面标题 26/32 -->
    <style name="Text.Trace.PageTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- 卡片标题 17/24 -->
    <style name="Text.Trace.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- 数据大号 44/44：mono + tabular（金额、总时长） -->
    <style name="Text.Trace.Metric" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">40sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- 指标大号 40 -->
    <style name="Text.Trace.Number" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- 正文 14/22 -->
    <style name="Text.Trace.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">5dp</item>
        <item name="android:textColor">@color/text_2</item>
    </style>

    <!-- 读数（等宽感，用于状态/日志面板） -->
    <style name="Text.Trace.Readout" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text_2</item>
    </style>

    <!-- 次要说明 11.5/19 -->
    <style name="Text.Trace.Meta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11.5sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/text_3</item>
    </style>

    <!-- 标注 10.5/16，数字与时间走 tabular -->
    <style name="Text.Trace.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">10.5sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/text_3</item>
    </style>

    <!-- Activity / 时间列：等宽，9-10.5sp -->
    <style name="Text.Trace.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_2</item>
    </style>
</resources>
