<?xml version="1.0" encoding="utf-8"?>
<!--
  历史总结：日历选日期 → 看那天的总结（独立页，从首页「历史总结」进）。
  日历格子在代码里按当月天数生成（DigestHistoryActivity.buildMonth），
  这里只放骨架，避免在 XML 里写 42 个格子。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/gutter"
            android:paddingEnd="@dimen/gutter"
            android:paddingTop="@dimen/gap_l"
            android:paddingBottom="@dimen/gap_l">

            <TextView
                style="@style/Text.Trace.PageTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="历史总结" />

            <TextView
                android:id="@+id/tvHistoryMeta"
                style="@style/Text.Trace.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:text="点日历上有圆点的日期，回看那天的总结" />

            <!-- 月份切换 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:background="@drawable/bg_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/gap_s"
                android:paddingTop="@dimen/gap_s"
                android:paddingEnd="@dimen/gap_s"
                android:paddingBottom="@dimen/gap_s">

                <Button
                    android:id="@+id/btnPrevMonth"
                    style="@style/Widget.Trace.Button.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="‹" />

                <TextView
                    android:id="@+id/tvMonth"
                    style="@style/Text.Trace.Section"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="—" />

                <Button
                    android:id="@+id/btnNextMonth"
                    style="@style/Widget.Trace.Button.Tonal"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:minWidth="0dp"
                    android:text="›" />
            </LinearLayout>

            <!-- 星期表头 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:orientation="horizontal">

                <TextView style="@style/Text.Trace.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="一" />
                <TextView style="@style/Text.Trace.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="二" />
                <TextView style="@style/Text.Trace.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="三" />
                <TextView style="@style/Text.Trace.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="四" />
                <TextView style="@style/Text.Trace.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="五" />
                <TextView style="@style/Text.Trace.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="六" />
                <TextView style="@style/Text.Trace.Caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="日" />
            </LinearLayout>

            <!-- 日历：行在代码里生成 -->
            <LinearLayout
                android:id="@+id/calRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_s"
                android:background="@drawable/bg_glass"
                android:orientation="vertical"
                android:paddingTop="@dimen/gap_s"
                android:paddingBottom="@dimen/gap_s" />

            <Button
                android:id="@+id/btnToday"
                style="@style/Widget.Trace.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_m"
                android:text="回到今天" />

            <!-- 选中那天的总结 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/bg_glass"
                android:orientation="vertical"
                android:padding="@dimen/card_pad">

                <TextView
                    android:id="@+id/tvDayTitle"
                    style="@style/Text.Trace.Section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—" />

                <TextView
                    android:id="@+id/tvDayText"
                    style="@style/Text.Trace.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:text="—" />

                <Button
                    android:id="@+id/btnDayWrite"
                    style="@style/Widget.Trace.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:text="写今天的总结"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnDayDetail"
                    style="@style/Widget.Trace.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:text="看喂给模型的数据"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvDayMeta"
                    style="@style/Text.Trace.Meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/gap_m"
                    android:text="" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>