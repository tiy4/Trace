<?xml version="1.0" encoding="utf-8"?>
<!-- 行为统计页。id：tvTop / tvEvents / btnGrant 由 BehaviorActivity.kt 引用。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/Text.Trace.PageTitle"
            android:text="行为统计" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 数据源：Android UsageStats（需在 vivo 设置中授权）"
            android:textSize="11sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:textColor="@color/text_3" />

        <TextView
            style="@style/Text.Trace.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="今日应用 Top 5"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Trace.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTop"
                style="@style/Text.Trace.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:lineSpacingExtra="6dp"
                android:text="加载中…" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Text.Trace.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧭 应用内行为（在哪个应用 · 在干什么）"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Trace.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvWhat"
                style="@style/Text.Trace.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:lineSpacingExtra="5dp"
                android:text="加载中…" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Text.Trace.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖  AI 实时行为流（监控服务采集）"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Trace.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvEvents"
                style="@style/Text.Trace.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:lineSpacingExtra="5dp"
                android:text="监控未开启，暂无实时事件。回首页点「开启行为监控」。" />
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnGrant"
            style="@style/Widget.Trace.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🔐 授予「使用情况访问」"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
