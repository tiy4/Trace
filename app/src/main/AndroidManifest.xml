<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      无障碍自愈用：OriginOS 会在后台把第三方无障碍服务摘掉（实测闲置约两小时后
      enabled_accessibility_services 变空），用户看到的就是「一开就自动关」。
      这个权限普通安装拿不到，由 scripts\enable-a11y.ps1 里的 adb `pm grant` 一次性授予；
      拿到之后 App 就能自己把服务写回去（见 A11yCapture.ensureEnabled）。
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Android 11+ 的包可见性：不加这段，PackageManager 对大多数应用会抛
      NameNotFoundException，AppNames 只能退回包名末段 → 行为统计里就出现
      「zqb / read / market」这种用户看不懂的东西（实测踩过）。
      声明 LAUNCHER intent 即可看见所有有桌面图标的应用（正是用户会用的那些）。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="Trace V0.1"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Trace"
        android:supportsRtl="true">

        <!-- singleTop：底栏在别的页面点「首页/记一笔」时复用本实例并走 onNewIntent，
             否则会不断新建 MainActivity 叠在栈上。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Trace V0.1">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RecordsActivity"
            android:exported="false"
            android:label="流水明细" />

        <activity
            android:name=".BehaviorActivity"
            android:exported="false"
            android:label="行为统计" />

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:label="AI 助手"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".DigestHistoryActivity"
            android:exported="false"
            android:label="历史总结" />

        <service
            android:name=".MonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".vlm.VlmCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|dataSync" />

        <!--
          无障碍截屏服务：只申请「截屏」能力，用于整屏读屏。
          用无障碍而不是 MediaProjection 的原因见 A11yCapture.kt 顶部注释。
        -->
        <service
            android:name=".vlm.TraceScreenAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
